    <string name="explain_location">Puede saber dónde está el dispositivo, con precisión o aproximada, mientras se usa la app.</string>
    <string name="explain_background_location">Puede leer la ubicación incluso con la app cerrada o fuera de pantalla.</string>
    <string name="explain_camera">Puede hacer fotos y grabar vídeo.</string>
    <string name="explain_microphone">Puede grabar audio.</string>
    <string name="explain_contacts">Puede leer o cambiar tus contactos y las cuentas del dispositivo.</string>
    <string name="explain_calendar">Puede leer o cambiar eventos del calendario.</string>
    <string name="explain_sms">Puede leer, recibir o enviar mensajes de texto.</string>
    <string name="explain_phone">Puede ver el estado y el número del teléfono, hacer llamadas y leer o cambiar el registro de llamadas.</string>
    <string name="explain_storage_media">Puede leer fotos, vídeos, audio o archivos del almacenamiento compartido.</string>
    <string name="explain_body_sensors">Puede leer el pulso y otros datos de sensores corporales.</string>
    <string name="explain_activity">Puede detectar pasos y actividades como caminar o ir en bici.</string>
    <string name="explain_nearby_devices">Puede buscar, conectarse y anunciarse a dispositivos Bluetooth, Wi-Fi y UWB cercanos.</string>
    <string name="explain_notifications">Puede mostrar notificaciones.</string>
    <string name="explain_overlay">Puede mostrar contenido encima de otras apps, algo que se puede usar para engañar pulsaciones.</string>
    <string name="explain_accessibility">Declara un servicio de accesibilidad. Cuando el usuario lo activa, puede leer la pantalla y actuar sobre ella.</string>
    <string name="explain_install_packages">Puede pedir la instalación de otras apps.</string>
    <string name="explain_all_files">Puede acceder a todos los archivos del almacenamiento compartido.</string>
    <string name="explain_device_admin">Declara un componente de administrador del dispositivo, que puede imponer políticas como bloquear o borrar el dispositivo.</string>
    <string name="explain_usage_access">Puede ver qué apps usas y durante cuánto tiempo.</string>
